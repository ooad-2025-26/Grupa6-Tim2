@* Lokacija: PopravkaBa.Web/Views/Profil/UrediProfil.cshtml *@
@model PopravkaBa.Application.DTOs.UrediProfilDto
@{
    ViewData["Title"] = "Uredi profil";
}

<div class="uredi-wrapper">
    <div class="uredi-header">
        <a asp-controller="Profil" asp-action="Detalji" asp-route-id="@Model.Id"
           class="uredi-nazad">
            <i class="bi bi-arrow-left"></i> Nazad na profil
        </a>
        <h1 class="uredi-naslov">Uredi profil</h1>
        <p class="uredi-podnaslov">Ažuriraj svoje podatke koji će biti vidljivi ostalim korisnicima.</p>
    </div>

    <form asp-controller="Profil" asp-action="UrediProfil" method="post" class="uredi-form">
        @Html.AntiForgeryToken()

        @* Skriveno polje sa ID-em — obavezno da bi controller znao čiji profil snimamo *@
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="JeFirma" />

        @* ── Lični podaci ── *@
        <div class="uredi-sekcija">
            <h2 class="uredi-sekcija-naslov">
                <i class="bi bi-person me-2"></i>Lični podaci
            </h2>

            @if (!Model.JeFirma)
            {
                <div class="uredi-row-2">
                    <div class="uredi-grupa">
                        <label asp-for="Ime" class="uredi-label"></label>
                        <input asp-for="Ime" class="uredi-input" placeholder="Npr. Rijad" />
                        <span asp-validation-for="Ime" class="uredi-greska"></span>
                    </div>
                    <div class="uredi-grupa">
                        <label asp-for="Prezime" class="uredi-label"></label>
                        <input asp-for="Prezime" class="uredi-input" placeholder="Npr. Kasapović" />
                        <span asp-validation-for="Prezime" class="uredi-greska"></span>
                    </div>
                </div>
            }
            else
            {
                <div class="uredi-grupa">
                    <label asp-for="NazivFirme" class="uredi-label"></label>
                    <input asp-for="NazivFirme" class="uredi-input" placeholder="Npr. Haso Instalacije d.o.o." />
                    <span asp-validation-for="NazivFirme" class="uredi-greska"></span>
                </div>
            }

            <div class="uredi-grupa">
                <label asp-for="Adresa" class="uredi-label"></label>
                <input asp-for="Adresa" class="uredi-input" placeholder="Npr. Titova 15, Sarajevo" />
                <span asp-validation-for="Adresa" class="uredi-greska"></span>
            </div>
        </div>

        @* ── O meni ── *@
        <div class="uredi-sekcija">
            <h2 class="uredi-sekcija-naslov">
                <i class="bi bi-file-text me-2"></i>O meni
            </h2>

            <div class="uredi-grupa">
                <label asp-for="Opis" class="uredi-label"></label>
                <textarea asp-for="Opis" class="uredi-textarea" rows="5"
                          placeholder="Opišite svoje iskustvo, specijalnosti i šta nudite klijentima..."></textarea>
                <span asp-validation-for="Opis" class="uredi-greska"></span>
                <span class="uredi-hint">Maksimalno 1000 karaktera</span>
            </div>
        </div>

        @* ── Usluge i cijena ── *@
        <div class="uredi-sekcija">
            <h2 class="uredi-sekcija-naslov">
                <i class="bi bi-tools me-2"></i>Usluge
            </h2>

            <div class="uredi-grupa uredi-grupa--pola">
                <label asp-for="MinCijenaUsluge" class="uredi-label"></label>
                <div class="uredi-input-s-sufiksom">
                    <input asp-for="MinCijenaUsluge" type="number" min="0" max="10000"
                           class="uredi-input" placeholder="Npr. 30" />
                    <span class="uredi-sufiks">KM/h</span>
                </div>
                <span asp-validation-for="MinCijenaUsluge" class="uredi-greska"></span>
                <span class="uredi-hint">Minimalna cijena vaših usluga po satu</span>
            </div>
        </div>

        @* ── Firma-specifična polja ── *@
        @if (Model.JeFirma)
        {
            <div class="uredi-sekcija">
                <h2 class="uredi-sekcija-naslov">
                    <i class="bi bi-building me-2"></i>Informacije o firmi
                </h2>

                <div class="uredi-grupa">
                    <label asp-for="WebStranica" class="uredi-label"></label>
                    <input asp-for="WebStranica" class="uredi-input" placeholder="https://vasa-firma.ba" />
                    <span asp-validation-for="WebStranica" class="uredi-greska"></span>
                </div>

                <div class="uredi-grupa">
                    <label asp-for="RadnoVrijeme" class="uredi-label"></label>
                    <input asp-for="RadnoVrijeme" class="uredi-input"
                           placeholder="Npr. Pon-Pet 08:00-16:00, Sub 09:00-13:00" />
                    <span asp-validation-for="RadnoVrijeme" class="uredi-greska"></span>
                </div>
            </div>
        }

        @* ── Akcijska dugmad ── *@
        <div class="uredi-akcije">
            <a asp-controller="Profil" asp-action="Detalji" asp-route-id="@Model.Id"
               class="uredi-btn-odustani">
                Odustani
            </a>
            <button type="submit" class="uredi-btn-sacuvaj">
                <i class="bi bi-check-lg me-1"></i> Sačuvaj izmjene
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .uredi-wrapper {
        max-width: 720px;
        margin: 2rem auto;
        padding: 0 1rem 4rem;
    }

    .uredi-header {
        margin-bottom: 2rem;
    }

    .uredi-nazad {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        color: #6b7280;
        text-decoration: none;
        font-size: .9rem;
        margin-bottom: 1rem;
    }

        .uredi-nazad:hover {
            color: #1a56db;
        }

    .uredi-naslov {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0 0 .25rem;
    }

    .uredi-podnaslov {
        color: #6b7280;
        font-size: .9rem;
        margin: 0;
    }

    .uredi-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .uredi-sekcija {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
        padding: 1.75rem;
    }

    .uredi-sekcija-naslov {
        font-size: .95rem;
        font-weight: 700;
        color: #374151;
        margin: 0 0 1.25rem;
        display: flex;
        align-items: center;
    }

        .uredi-sekcija-naslov i {
            color: #1a56db;
        }

    .uredi-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 520px) {
        .uredi-row-2 {
            grid-template-columns: 1fr;
        }
    }

    .uredi-grupa {
        display: flex;
        flex-direction: column;
        gap: .35rem;
        margin-bottom: 1rem;
    }

        .uredi-grupa:last-child {
            margin-bottom: 0;
        }

    .uredi-grupa--pola {
        max-width: 280px;
    }

    .uredi-label {
        font-size: .85rem;
        font-weight: 600;
        color: #374151;
    }

    .uredi-input, .uredi-textarea {
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: .6rem .9rem;
        font-size: .9rem;
        color: #111;
        transition: border-color .15s;
        outline: none;
        width: 100%;
        background: #fff;
    }

        .uredi-input:focus, .uredi-textarea:focus {
            border-color: #1a56db;
            box-shadow: 0 0 0 3px rgba(26,86,219,.08);
        }

    .uredi-textarea {
        resize: vertical;
        min-height: 110px;
    }

    .uredi-input-s-sufiksom {
        display: flex;
        align-items: center;
    }

        .uredi-input-s-sufiksom .uredi-input {
            border-radius: 8px 0 0 8px;
            border-right: none;
        }

    .uredi-sufiks {
        background: #f3f4f6;
        border: 1.5px solid #e5e7eb;
        border-left: none;
        border-radius: 0 8px 8px 0;
        padding: .6rem .9rem;
        font-size: .85rem;
        color: #6b7280;
        white-space: nowrap;
    }

    .uredi-greska {
        color: #dc2626;
        font-size: .78rem;
    }

    .uredi-hint {
        color: #9ca3af;
        font-size: .78rem;
    }

    .uredi-akcije {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        padding-top: .5rem;
    }

    .uredi-btn-odustani {
        background: #fff;
        color: #374151;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: .65rem 1.5rem;
        font-weight: 600;
        text-decoration: none;
        font-size: .9rem;
    }

        .uredi-btn-odustani:hover {
            background: #f9fafb;
            color: #111;
        }

    .uredi-btn-sacuvaj {
        background: #1a56db;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .65rem 1.75rem;
        font-weight: 600;
        font-size: .9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

        .uredi-btn-sacuvaj:hover {
            background: #1447b8;
        }
</style>
